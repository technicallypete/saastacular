# Canonical project configuration. This is the single source of configuration
# for infra/compose/local.yml: copy it to .env, then fill in every empty
# secret with a locally generated value. Never commit .env.
#
# Product, domain and database identity live ONLY in this file. Source code,
# Compose and documentation resolve them at runtime from these variables, so
# the product can be renamed or re-domained without editing source.

# --- Product identity and domains -------------------------------------------
PRODUCT_NAME="SaaStacular"
PLATFORM_BASE_DOMAIN=foundation.test
CUSTOM_DOMAIN_CNAME_TARGET=custom.foundation.test
DATABASE_NAME=saas_foundation
COMPOSE_PROJECT_NAME=saas-foundation
APP_ENV=development
# Host-published ports bind here. Keep loopback for local development.
BIND_ADDRESS=127.0.0.1

# --- Host ports (conventional port + 100 where a standard exists) ------------
WEB_PORT=3100
CORE_PORT=8180
INTELLIGENCE_PORT=8100
POSTGRES_PORT=5532
REDIS_PORT=6479
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- Internal wiring (container-to-container; conventional internal ports) --
CORE_INTERNAL_URL=http://core:8180
INTELLIGENCE_URL=http://intelligence:8000
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=saas-foundation-objects
OBJECT_STORE_FORCE_PATH_STYLE=true
OBJECT_STORE_ACCESS_KEY=core-service
MINIO_ROOT_USER=minio-root

# --- Secrets: empty here, required at startup -------------------------------
# Generate locally as HEX (URL-safe), at least 16 characters, for example:
#   head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'
# POSTGRES_SUPERUSER_PASSWORD is used only by database initialization.
POSTGRES_SUPERUSER_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_RUNTIME_PASSWORD=
DB_RETENTION_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_PASSWORD=
OBJECT_STORE_SECRET_KEY=
INTELLIGENCE_SERVICE_TOKEN=

# --- AI model configuration: AI_MODEL_<CAPABILITY>=<provider>:<model> -------
# A capability is enabled only when its variable is set. Fallbacks use the same
# provider:model syntax, comma separated. Name the model provider, never the
# gateway. Commented lines are SAMPLES ONLY, not claims of model availability.
# AI_MODEL_CHAT=<provider>:<model>
# AI_MODEL_FAST=<provider>:<model>
# AI_MODEL_REASONING=<provider>:<model>
# AI_MODEL_EXTRACTION=<provider>:<model>
# AI_MODEL_EMBEDDING=<provider>:<model>
# AI_MODEL_CHAT_FALLBACKS=<provider>:<model>,<provider>:<model>
# Gateway credential (secret). Optional at startup; required only for live calls.
OPENROUTER_API_KEY=

# --- Identity provider: WorkOS AuthKit (docs/foundation/IDENTITY.md) --------
# Read by core (web reads only IDENTITY_COOKIE_PROFILE). Leaving the client ID,
# issuer and API key unset keeps identity unconfigured: sign-in reports it is
# unavailable, and production refuses to start. The API key is a secret: set it
# (or IDENTITY_WORKOS_API_KEY_FILE) only in a deployment's secret store.
IDENTITY_PROVIDER=workos
# IDENTITY_WORKOS_CLIENT_ID=client_<id>
# IDENTITY_WORKOS_ISSUER=<the exact iss of a real access token; IDENTITY.md>
# IDENTITY_WORKOS_API_KEY=
# IDENTITY_PUBLIC_ORIGINS=https://<host>,https://<other-host>
# IDENTITY_COOKIE_PROFILE=https
# IDENTITY_SESSION_IDLE=30m
# IDENTITY_SESSION_ABSOLUTE=8h
# IDENTITY_MAX_AUTH_AGE=
# --- Hostnames and custom domains (docs/foundation/DOMAINS.md) -------------
# Read by core. Tenant hosts are <slug>.PLATFORM_BASE_DOMAIN and verified
# custom domains (no host registry); IDENTITY_PUBLIC_ORIGINS then lists only
# the shared auth host, https://PLATFORM_AUTH_HOST. The platform domain and
# www.<it> serve the landing (signup runs on the platform domain only). None
# of these values is a secret; the defaults apply when a line stays commented.
# PLATFORM_AUTH_HOST=auth.<PLATFORM_BASE_DOMAIN>
# PLATFORM_RESERVED_LABELS=
# CUSTOM_DOMAIN_CHALLENGE_LABEL=_platform-verify
# CUSTOM_DOMAIN_CHALLENGE_TTL=168h
# CUSTOM_DOMAIN_PROOF_FRESHNESS=720h
# CUSTOM_DOMAIN_DNS_TIMEOUT=5s
# DOMAIN_TLS_ADAPTER=edge-probe
# DOMAIN_TLS_EDGE_ADDR=<CUSTOM_DOMAIN_CNAME_TARGET>:443
# DOMAIN_TLS_TIMEOUT=5s
# DOMAIN_WITHDRAWAL_RETRY_MAX=5
# Root host (G071; DOMAINS.md "Default-tenant root alias and root
# presentation"). Core reads both once at startup: edit, then restart core.
# DEFAULT_TENANT_SLUG names the slug of an existing Organization; the exact
# platform domain (not www.<it>) then serves that Organization's tenant pages,
# and every /signup path there is 404. Unset or empty keeps multi-tenant
# operation; an unknown or malformed slug logs a warning and is ignored.
# PLATFORM_ROOT_PAGE selects the multi-tenant root: signup_redirect (default,
# also when unset or empty: GET/HEAD / answers 307 to /signup) or landing; an
# invalid value warns and uses the default. www.<it> keeps its landing.
# DEFAULT_TENANT_SLUG=
# PLATFORM_ROOT_PAGE=signup_redirect
